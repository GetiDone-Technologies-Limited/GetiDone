# Supabase Connection Pooler (Port 6543) - Used by NestJS / Prisma at runtime
DATABASE_URL="postgresql://postgres.ueacqckeqnunrnqipjpa:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection (Port 5432) - Used by Prisma CLI for migrations / schema push
DIRECT_URL="postgresql://postgres.ueacqckeqnunrnqipjpa:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# Supabase API Credentials
SUPABASE_URL="https://ueacqckeqnunrnqipjpa.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Server Port & Environment
PORT=10000
NODE_ENV=production

# Security & JWT
JWT_SECRET="generate-a-secure-random-secret-key-here"

# AI Model Provider Keys (Optional)
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
ZHIPU_API_KEY=""
